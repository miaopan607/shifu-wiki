{
	"name": "shifu-wiki-vue3",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "vite preview",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"deploy": "pnpm build && rsync -avz --delete ./dist/ wiki:/opt/docker/shifu-wiki/frontend/dist/"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"marked": "^17.0.2",
		"pocketbase": "^0.26.8",
		"tailwindcss": "^4.1.18",
		"vue": "^3.5.27",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.10.9",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vue/tsconfig": "^0.8.1",
		"npm-run-all2": "^8.0.4",
		"prettier": "^3.8.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-vue-devtools": "^8.0.5",
		"vue-tsc": "^3.2.4"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
